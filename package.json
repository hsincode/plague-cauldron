{
  "name": "plague-cauldron",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --port 5174 ./index.html ./gallery.html",
    "build": "bun build ./index.html --outdir dist --minify && bun tools/notices.ts",
    "preview": "bun tools/preview.ts",
    "deploy": "bun run build && cd dist && bunx vercel link --yes --project plague-cauldron --team hsincode && bunx vercel deploy . --prod --yes",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 60000"
  },
  "dependencies": {
    "three": "0.171.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/three": "0.171.0",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2"
  }
}
